# Solana RPC with websocket support (Helius, QuickNode, Triton...). The public
# endpoint rate-limits too hard for this.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional; derived from RPC_URL when unset.
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Needed when config.leaderboard is set: a Bitquery access token (starts with
# "ory_at_"), not the older v1 API key.
# BITQUERY_TOKEN=

# Only needed for mode "live". Base58 secret key or JSON byte array.
# Use a dedicated wallet holding only what you are willing to lose.
# PRIVATE_KEY=

# Optional Jupiter API key (sent as x-api-key).
# JUPITER_API_KEY=
